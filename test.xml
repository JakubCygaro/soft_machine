<graph>
    <memory name="MEM">
        <position x="0" y="0"/>
        <memset>1 2 3 4</memset>
    </memory>
    <cpu name="CPU">
        <position x="50" y="0"/>
        <code>
            <wait
                on="CPU-TRIGGER"
                into="R0"/>
            <load
                from="CPU-MEM"
                at="0"
                into="R1"/>
            <add
                src="R1"
                dst="R0"/>
        </code>
    </cpu>
    <button name="TRIG" target="CPU-TRIG" >
        <send number="20"/>
    </button>
</graph>
