<graph>
    <memory name="MEM" layout="vertical">
        <position x="-400" y="0"/>
        <memset>1 2 3 5 100</memset>
    </memory>
    <cpu name="CPU">
        <position x="200" y="0"/>
        <code>
            <wait
                on="TRIG-CPU"
                into="R1"/>
            <load
                from="MEM-CPU"
                at="0"
                into="R0"/>
            <add
                src="R1"
                dst="R0"/>
            <send
                from="R0"
                to="CPU-DISP"
                />
        </code>
    </cpu>
    <passthrough name="MEM-CPU">
        <from name="MEM" at="R"/>
        <to name="CPU" at="L"/>
    </passthrough>
    <button name="TRIG" width="200" height="200">
        <position x="200" y="-250"/>
        <value kind="number">2</value>
    </button>
    <passthrough name="TRIG-CPU">
        <from name="TRIG" at="TC"/>
        <to name="CPU" at="BC"/>
    </passthrough>
    <display name="DISPLAY"
        width="200"
        height="200"
        font_size="24" >
        <position x="1500" y="0"/>
    </display>
    <passthrough name="CPU-DISP">
        <from name="CPU" at="R"/>
        <to name="DISPLAY" at="L"/>
    </passthrough>
</graph>
