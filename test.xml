<graph>
    <memory name="MEM" layout="vertical">
        <position x="-400" y="0"/>
        <memset>1 2 3 5 100</memset>
    </memory>
    <cpu name="CPU">
        <position x="200" y="0"/>
        <code>
            <wait
                on="CPU-TRIGGER"
                into="R0"/>
            <load
                from="CPU-MEM"
                at="0"
                into="R1"/>
            <add
                src="R1"
                dst="R0"/>
        </code>
    </cpu>
    <passthrough name="MEM-CPU">
        <from name="MEM" at="R"/>
        <to name="CPU" at="L"/>
    </passthrough>
    <button name="TRIG" target="CPU-TRIG" >
        <send number="20"/>
    </button>
</graph>
